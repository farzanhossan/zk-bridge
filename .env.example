# ---- Device (ZKTeco K40 on the office LAN) ----
# The K40 must have a static IP and Comm Key = 0 (zkteco-js has no Comm Key support).
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
# Socket timeout for each device request, in ms.
DEVICE_TIMEOUT_MS=10000
# Local UDP port, only used if the library falls back to UDP.
DEVICE_UDP_INPORT=5200
# IANA timezone the device clock is set to. Device timestamps carry no offset.
DEVICE_TIMEZONE=Asia/Dhaka

# ---- CRM (not needed for `npm run poc`) ----
# Must be https:// (http:// is allowed only for localhost / 127.0.0.1).
CRM_BASE_URL=https://crm.example.com/api
CRM_DEVICE_KEY=replace-me

# ---- Schedules ----
FULL_PULL_INTERVAL_SEC=600
FLUSH_INTERVAL_SEC=15
HEARTBEAT_INTERVAL_SEC=60
COMMAND_POLL_INTERVAL_SEC=20
# 0 disables automatic device clock sync.
TIME_SYNC_INTERVAL_HOURS=24

# ---- Local storage / logging ----
# Relative paths are resolved from the project folder.
OUTBOX_PATH=./data/outbox.db
# debug | info | warn | error
LOG_LEVEL=info
